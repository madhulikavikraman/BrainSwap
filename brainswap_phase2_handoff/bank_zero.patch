     def _reset_parameters(self):
+        if self.init_scheme == "mha":
+            # Mirror nn.MultiheadAttention._reset_parameters: one xavier draw over
+            # the stacked (3E, E) in-projection, zero in-proj bias, out_proj keeps
+            # nn.Linear's default init with a zero bias. Per-projection xavier
+            # (the default below) gives q/k/v weights a sqrt(2) wider range and
+            # out_proj a sqrt(3) wider range than PyTorch attention.
+            E = self.embed_dim
+            w = torch.empty(3 * E, E)
+            nn.init.xavier_uniform_(w)
+            with torch.no_grad():
+                self.q_proj.weight.copy_(w[:E])
+                self.k_proj.weight.copy_(w[E:2 * E])
+                self.v_proj.weight.copy_(w[2 * E:])
+            self.out_proj.reset_parameters()
+            if self.q_proj.bias is not None:
+                for m in (self.q_proj, self.k_proj, self.v_proj, self.out_proj):
+                    nn.init.zeros_(m.bias)
+            return
         nn.init.xavier_uniform_(self.q_proj.weight)
